# Copy to .env (git-ignored) and fill in. Never commit real values.

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. Defaults to data/predictions.db
# DATABASE_URL=

# Optional. Without these, alert rows record "not sent: email not configured".
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
