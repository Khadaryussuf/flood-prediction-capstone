# Copy to .env (git-ignored) and fill in. Never commit real values.

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. Defaults to data/predictions.db
# DATABASE_URL=

# Optional. Without these, alert rows record "not sent: email not configured".
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Optional: "Continue with Google". Create an OAuth client (type "Web application")
# in Google Cloud and add http://127.0.0.1:5000/api/auth/google/callback as an
# authorised redirect URI. Without both values the button doesn't appear.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Only if the server is reached through another address, such as a proxy:
# GOOGLE_REDIRECT_URI=

# ---- Production server (python -m backend.wsgi, and the Docker image) ----
# One waitress process; scale with threads, never with more processes.
# PORT=8000
# HOST=0.0.0.0
# WAITRESS_THREADS=8
# Folder for the database (DATA_DIR/floodwatch.db) when DATABASE_URL isn't set.
# The Docker image sets DATA_DIR=/data; mount a volume there.
# DATA_DIR=
# Behind a reverse proxy that ends HTTPS: how many proxies to trust for
# X-Forwarded-For/-Proto/-Host/-Port. Leave unset when nothing sits in front.
# TRUSTED_PROXIES=1

# ---- Demo accounts, created only on the first start of an empty database ----
# Same password rules as sign-up. Remove the passwords from the environment
# once the accounts exist; later starts never read them.
# DEMO_ADMIN_EMAIL=
# DEMO_ADMIN_PASSWORD=
# DEMO_RESPONDER_EMAIL=
# DEMO_RESPONDER_PASSWORD=
# DEMO_ORGANISATION=
